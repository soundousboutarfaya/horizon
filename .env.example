# Copy this file to `.env` and adjust the values.
# In development you can load it with:  node --env-file=.env server.js
# (the `npm run dev` / `npm start` scripts already do this).

# HTTP port the server listens on
PORT=3000

# Admin panel credentials (Basic Auth).
# IMPORTANT: change these before deploying anywhere public.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# Optional: override the SQLite database file path.
# Use ":memory:" for an ephemeral database (used by the test suite).
# HORIZON_DB=./horizon.db

# Optional: override the uploads directory.
# UPLOADS_DIR=./uploads
